DISCORD_BOT_TOKEN="..."
# 로컬 개발 서버 ID. 값을 넣으면 길드 명령어로 즉시 반영되며, 운영에서는 설정하지 않습니다.
DISCORD_GUILD_ID=""
NEXON_API_KEY="..."
SUNDAY_CHANNEL_ID="..." # 썬데이 메이플 백그라운드 공지를 전송할 디스코드 채널 ID (금요일 10시 5분 실행)

# 로컬 Docker 개발용 MySQL 설정
MYSQL_HOST="mysql"
MYSQL_PORT="3306"
MYSQL_DATABASE="maple_sunday_bot"
MYSQL_USER="maple_bot"
MYSQL_PASSWORD="local-dev-password"
MYSQL_TLS_MODE="false"
MYSQL_ROOT_PASSWORD="local-root-password"

# 사용자 넥슨 API Key 암호화용 AES-256 키 (`openssl rand -base64 32`로 생성)
API_KEY_ENCRYPTION_KEY="..."
# 키 교체 시 기존 키를 쉼표로 구분해 보관 (없으면 빈 값)
API_KEY_ENCRYPTION_PREVIOUS_KEYS=""

# 운영 MySQL 전환 전까지 현행 Supabase 배포에서만 사용하는 선택 설정
# DATABASE_URL="postgresql://..."
